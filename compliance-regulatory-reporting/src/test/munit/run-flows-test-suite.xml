	<munit:test name="run-flows-test-suite-claim-run-flowTest" doc:id="4aa74729-1001-406e-8aa3-41f99ff29624" description="Test">
		<munit:behavior >
			<munit:set-event doc:name="Set Event" doc:id="1ecf2319-34eb-4eb2-b58d-31053484fdae" >
				<munit:payload value='#[output application/java --- { reportType: "STR", entityCode: "ENT0091", periodStart: "2026-09-10T16:00:00Z", periodEnd: "2026-09-11T16:00:00Z", triggeredBy: "SCHEDULER" }]' />
			</munit:set-event>
			<munit-tools:mock-when doc:name="Mock when" doc:id="531a5d3a-03c4-4f5b-893f-492674fc9605" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Select" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="5a095f1c-1cdf-4401-9c85-cbcfd12f1bee" attributeName="doc:id" />
					<munit-tools:with-attribute whereValue="Database_Config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[[{ run_id: "RUN-TEST1", sequence_number: 1, is_revision: false }]]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow-ref to claim-run-flow" doc:id="81268ecc-eada-4a03-9f9f-5ca6259c4526" name="claim-run-flow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="34f1625d-7847-4500-9be9-f1f73cd67587" expression="#[payload.sequence_number]" is="#[MunitTools::equalTo(1)]"/>
			<munit-tools:assert-that doc:name="Assert that" doc:id="1b1ffed0-3db9-476f-93e7-e5b52e417fba" expression="#[payload.is_revision]" is="#[MunitTools::equalTo(false)]"/>
		</munit:validation>
	</munit:test>
	<munit:test name="run-flows-test-suite-finalize-run-flowTest" doc:id="63e293c3-6516-4503-b032-db210c100542" description="Test">
		<munit:behavior >
			<munit:set-event doc:name="Set Event" doc:id="20e4e4c9-f242-4e73-b642-bc73d2c17562" >
				<munit:payload value='#[output application/java --- { runId: "RUN-TEST1", recordCount: 3, totalAmount: 2378500.00, customerCount: 3 }]' />
			</munit:set-event>
			<munit-tools:mock-when doc:name="Mock when" doc:id="3ea0e460-39d6-42e1-9c5a-34dea8d92283" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Select" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="f85bf9d3-3003-4107-ac14-b1a139f12d4a" attributeName="doc:id" />
					<munit-tools:with-attribute whereValue="Database_Config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[{ flags_updated: 3, run_updated: 1, control_updated: 1 }]]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow-ref to finalize-run-flow" doc:id="d6bb6a0f-32a5-423c-b567-ea96ff01e914" name="finalize-run-flow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="0627d12f-3afa-4b3d-88eb-7ad9878e8232" expression="#[payload.flags_updated]" is="#[MunitTools::equalTo(3)]"/>
		</munit:validation>
	</munit:test>
	<munit:test name="run-flows-test-suite-fail-run-flowTest" doc:id="7bf4fa4c-1e03-4b80-9410-3385e8e1e094" description="Test">
		<munit:behavior >
			<munit:set-event doc:name="Set Event" doc:id="1c674f63-5d78-44e1-a853-b03f7aedc298" >
				<munit:payload value='#[output application/java --- { runId: "RUN-TEST1", failureReason: "Completeness mismatch" }]' />
